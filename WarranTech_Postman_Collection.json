{
  "info": {
    "name": "WarranTech API",
    "description": "WarranTech — Warranty & Digital Receipt Organizer\nGroup 6 | APPINTR BTIS3 AY 25-26",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"password\": \"testpass123\",\n  \"password2\": \"testpass123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access);",
                  "pm.collectionVariables.set('refresh_token', json.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/refresh/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/profile/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Receipts",
      "item": [
        {
          "name": "List Receipts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/items/?search=samsung&ordering=-warranty_end&page=1",
              "host": ["{{base_url}}"],
              "path": ["api","items",""],
              "query": [
                { "key": "search", "value": "samsung" },
                { "key": "ordering", "value": "-warranty_end" },
                { "key": "page", "value": "1" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Receipt",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/items/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Samsung 55-inch QLED TV", "type": "text" },
                { "key": "store", "value": "SM Appliance Center", "type": "text" },
                { "key": "category", "value": "electronics", "type": "text" },
                { "key": "purchase_date", "value": "2026-04-13", "type": "text" },
                { "key": "price", "value": "45999.00", "type": "text" },
                { "key": "warranty_end", "value": "2028-04-13", "type": "text" },
                { "key": "notes", "value": "Serial: SN-12345-XYZ", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Get Receipt",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/items/1/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Update Receipt (PATCH)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/items/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated: Model QN55Q60CAFXZA\"\n}"
            }
          }
        },
        {
          "name": "Delete Receipt",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/items/1/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Reminders",
      "item": [
        {
          "name": "Get Reminders (expiring ≤ 30 days)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/reminders/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
